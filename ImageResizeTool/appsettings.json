{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageProcessing": {
    "MaxFileSizeBytes": 20971520,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".bmp",
      ".gif"
    ],
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/bmp",
      "image/gif"
    ],
    "MaxInputWidth": 10000,
    "MaxInputHeight": 10000,
    "MaxInputPixels": 50000000,
    "MaxOutputWidth": 10000,
    "MaxOutputHeight": 10000,
    "MinDimension": 1,
    "DefaultJpegQuality": 85,
    "DefaultWebpQuality": 85,
    "DefaultJpegCompressQuality": 75,
    "DefaultWebpCompressQuality": 75,
    "DefaultPngZLibLevel": 9
  },
  "RateLimiting": {
    "PermitLimit": 30,
    "WindowSeconds": 60,
    "QueueLimit": 0
  }
}

