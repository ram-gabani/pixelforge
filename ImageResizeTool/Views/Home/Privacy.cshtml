                <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>Legal Compliance &amp; Transparency Center</span>
        </div>
        <h1 class="fw-bold display-6 mb-2 hero-title">Privacy Policy &amp; Terms of Service</h1>
        <p class="text-secondary mb-0">Effective Date: January 1, 2026 &bull; Last Revised: September 2026</p>
    </div>

