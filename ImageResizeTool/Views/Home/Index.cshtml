@{
    ViewData["Title"] = "PixelForge — Image Resize & Compression";
}

<div class="container py-3 max-w-1140">
    <!-- Hero Header -->
    <div class="text-center mb-5 hero-section">
        <div class="hero-logo-container mb-3 d-inline-block">
            <img src="~/images/logo.png" alt="PixelForge Logo" class="hero-logo-img rounded-4 shadow-sm" width="84" height="84" />
        </div>
        <h1 class="fw-bold display-6 mb-2 hero-title">PixelForge</h1>
        <p class="lead fw-semibold text-body mb-2 hero-tagline">Resize. Compress. Keep your pixels.</p>
        <p class="text-secondary mb-0 hero-subtitle">A fast, private image resizing and compression tool. Your images are processed in memory and are not permanently stored.</p>
    </div>

    <!-- Status / Error Live Region -->
    <div id="statusAlert" class="alert d-none mb-4 alert-floating" role="alert" aria-live="polite"></div>

    <div class="row g-4">
        <!-- Left Column: Upload & Original Image Preview -->
        <div class="col-lg-6">
            <!-- Dropzone -->
            <div id="uploadDropzone" class="dropzone p-4 p-md-5 text-center rounded-4 mb-3" tabindex="0" role="button" aria-label="Upload an image by clicking or dragging and dropping">
                <input type="file" id="imageFileInput" class="visually-hidden" accept=".jpg,.jpeg,.png,.webp,.bmp,.gif,image/jpeg,image/png,image/webp,image/gif,image/bmp" />
                <div class="dropzone-icon mb-3">
                    <div class="icon-circle mx-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                    </div>
                </div>
                <h5 class="fw-bold mb-1">Drag &amp; drop your image here</h5>
                <p class="text-secondary small mb-3">or browse from your device</p>
                <button type="button" id="browseBtn" class="btn btn-primary px-4 py-2 fw-semibold rounded-3 mb-3 btn-hover-elevate">
                    Choose Image
                </button>
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-1.5 small text-muted">
                    <span class="badge bg-white text-secondary border px-2 py-1">JPG</span>
                    <span class="badge bg-white text-secondary border px-2 py-1">PNG</span>
                    <span class="badge bg-white text-secondary border px-2 py-1">WebP</span>
                    <span class="badge bg-white text-secondary border px-2 py-1">GIF</span>
                    <span class="badge bg-white text-secondary border px-2 py-1">BMP</span>
                    <span class="text-muted ms-1">&bull; Up to 20 MB</span>
                </div>
            </div>

            <!-- Compact Trust Badge -->
            <div class="d-flex align-items-center justify-content-center gap-2 mb-3 text-secondary small trust-badge-row">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success flex-shrink-0">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="m9 12 2 2 4-4"/>
                </svg>
                <span>Images processed in memory &bull; No permanent image storage</span>
            </div>

            <!-- Inspecting Indicator -->
            <div id="inspectingIndicator" class="card card-custom shadow-xs mb-3 d-none text-center p-4">
                <div class="d-flex align-items-center justify-content-center gap-3 py-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <span class="fw-medium text-secondary">Reading image details...</span>
                </div>
            </div>

            <!-- Preview Card -->
            <div id="previewCard" class="card card-custom shadow-xs mb-3 d-none">
                <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                        <h5 class="card-title mb-0 fw-semibold fs-6">Original Image</h5>
                    </div>
                    <span id="previewBadge" class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">Ready</span>
                </div>
                <div class="card-body p-3 text-center">
                    <div class="preview-container checkerboard-bg rounded-3">
                        <img id="originalImagePreview" src="" alt="Selected original image preview" class="img-fluid rounded original-preview-img" />
                    </div>
                </div>
            </div>

            <!-- Metadata Summary Card -->
            <div id="metadataCard" class="card card-custom shadow-xs mb-3 d-none">
                <div class="card-header py-2.5 px-4 border-bottom">
                    <h5 class="card-title mb-0 fw-semibold fs-6">Image Details</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush rounded-bottom-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2.5 px-4">
                            <span class="text-secondary small">Filename</span>
                            <span id="metaFileName" class="fw-medium text-break text-end font-monospace small">photo.jpg</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2.5 px-4">
                            <span class="text-secondary small">Format</span>
                            <span id="metaFormat" class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle font-monospace">JPEG</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2.5 px-4">
                            <span class="text-secondary small">Dimensions</span>
                            <span id="metaDimensions" class="fw-semibold font-monospace">1920 × 1080 px</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2.5 px-4">
                            <span class="text-secondary small">Aspect Ratio</span>
                            <span id="metaAspectRatio" class="badge bg-info-subtle text-info-emphasis border border-info-subtle font-monospace">16:9</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2.5 px-4">
                            <span class="text-secondary small">File Size</span>
                            <span id="metaFileSize" class="fw-medium font-monospace">2.41 MB</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Right Column: Operation Controls (Resize / Compress) -->
        <div class="col-lg-6">
            <!-- Initial Empty State Placeholder -->
            <div id="initialStatePrompt" class="card card-custom border text-center p-5 mb-3 shadow-xs h-100 d-flex flex-column justify-content-center">
                <div class="py-4">
                    <div class="icon-circle mx-auto mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                            <circle cx="8.5" cy="8.5" r="1.5"/>
                            <polyline points="21 15 16 10 5 21"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-2">Choose an image to get started</h5>
                    <p class="text-secondary small mb-0 max-w-350 mx-auto">
                        Upload or drag an image on the left to unlock dimension resizing, aspect-ratio controls, and compression options.
                    </p>
                </div>
            </div>

            <!-- Tool Mode Switcher -->
            <div class="card card-custom shadow-xs mb-3 d-none" id="toolModeCard">
                <div class="card-body p-2">
                    <div class="btn-group w-100 tool-mode-tabs" role="group" aria-label="Tool operation selector">
                        <button type="button" class="btn btn-primary fw-semibold py-2.5 rounded-3 me-1" id="tabResizeMode">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="me-1.5 align-text-bottom">
                                <path d="M15 3h6v6"/>
                                <path d="M9 21H3v-6"/>
                                <path d="M21 3l-7 7"/>
                                <path d="M3 21l7-7"/>
                            </svg>
                            Resize
                        </button>
                        <button type="button" class="btn btn-outline-primary fw-semibold py-2.5 rounded-3" id="tabCompressMode">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="me-1.5 align-text-bottom">
                                <polyline points="4 14 10 14 10 20"/>
                                <polyline points="20 10 14 10 14 4"/>
                                <line x1="14" y1="10" x2="21" y2="3"/>
                                <line x1="3" y1="21" x2="10" y2="14"/>
                            </svg>
                            Compress
                        </button>
                    </div>
                </div>
            </div>

            <!-- Resize Configuration Controls Card -->
            <div class="card card-custom shadow-xs d-none" id="controlsCard">
                <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="card-title mb-0 fw-semibold fs-6">Resize Settings</h5>
                    <span id="controlsLockBadge" class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-2.5 py-1">
                        Ratio Locked
                    </span>
                </div>
                <div class="card-body p-4">
                    <!-- Mode Selection: Segmented Radio Buttons -->
                    <label class="form-label fw-bold text-secondary small text-uppercase tracking-wider mb-2">Resize Mode</label>
                    <div class="btn-group w-100 mb-4 segmented-control" role="group" aria-label="Resize mode selector">
                        <input type="radio" class="btn-check" name="resizeModeRadio" id="modePercentage" value="Percentage" autocomplete="off" checked>
                        <label class="btn btn-outline-primary py-2 fw-semibold" for="modePercentage">By Percentage</label>

                        <input type="radio" class="btn-check" name="resizeModeRadio" id="modeCustom" value="CustomDimensions" autocomplete="off">
                        <label class="btn btn-outline-primary py-2 fw-semibold" for="modeCustom">Custom Dimensions</label>
                    </div>

                    <!-- Panel A: Percentage Controls -->
                    <div id="percentageSection">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label for="percentageInput" class="form-label fw-semibold mb-0 small text-secondary">Scaling Percentage</label>
                            <div class="input-group input-group-sm" style="width: 110px;">
                                <input type="number" id="percentageInput" class="form-control text-end fw-bold font-monospace" min="1" max="500" value="100" />
                                <span class="input-group-text fw-semibold">%</span>
                            </div>
                        </div>

                        <!-- Slider -->
                        <div class="range-slider-wrapper mb-3">
                            <input type="range" id="percentageSlider" class="form-range custom-range" min="1" max="500" value="100" aria-label="Scaling percentage slider" />
                        </div>

                        <!-- Quick Presets -->
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <button type="button" class="btn btn-sm btn-outline-secondary preset-btn rounded-pill px-2.5" data-percent="25">25%</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary preset-btn rounded-pill px-2.5" data-percent="50">50%</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary preset-btn rounded-pill px-2.5" data-percent="75">75%</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary preset-btn rounded-pill px-2.5 active" data-percent="100">100%</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary preset-btn rounded-pill px-2.5" data-percent="200">200%</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary preset-btn rounded-pill px-2.5" data-percent="400">400%</button>
                        </div>
                    </div>

                    <!-- Panel B: Custom Dimensions Controls -->
                    <div id="customDimensionsSection" class="d-none">
                        <!-- Maintain Aspect Ratio Toggle -->
                        <div class="custom-switch-card p-3 rounded-3 bg-light border mb-3 d-flex align-items-center justify-content-between">
                            <div>
                                <label class="form-check-label fw-semibold d-block" for="aspectRatioLockToggle">
                                    Maintain Aspect Ratio
                                </label>
                                <span class="text-secondary small">Automatically recalculates reciprocal dimension</span>
                            </div>
                            <div class="form-check form-switch mb-0 fs-5">
                                <input class="form-check-input" type="checkbox" role="switch" id="aspectRatioLockToggle" checked />
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label for="targetWidthInput" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Width</label>
                                <div class="input-group">
                                    <input type="number" id="targetWidthInput" class="form-control font-monospace fw-semibold" min="1" max="10000" placeholder="Width" />
                                    <span class="input-group-text small text-muted">px</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label for="targetHeightInput" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Height</label>
                                <div class="input-group">
                                    <input type="number" id="targetHeightInput" class="form-control font-monospace fw-semibold" min="1" max="10000" placeholder="Height" />
                                    <span class="input-group-text small text-muted">px</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3 text-muted opacity-25" />

                    <!-- Output Format & Quality Section -->
                    <div class="mb-3">
                        <label for="outputFormatSelect" class="form-label fw-bold text-secondary small text-uppercase tracking-wider mb-1">Output Format</label>
                        <select id="outputFormatSelect" class="form-select fw-semibold mb-1">
                            <option value="jpeg">JPEG (.jpg) - Universal compatibility</option>
                            <option value="png">PNG (.png) - Lossless with alpha channel</option>
                            <option value="webp">WebP (.webp) - Modern lightweight format</option>
                        </select>
                        <div id="formatNotice" class="form-text text-muted small"></div>
                    </div>

                    <div id="qualitySection" class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="qualitySlider" class="form-label small fw-semibold text-secondary mb-0">Quality</label>
                            <span id="qualityValueBadge" class="badge bg-secondary font-monospace">85%</span>
                        </div>
                        <div class="range-slider-wrapper mb-1">
                            <input type="range" id="qualitySlider" class="form-range custom-range" min="1" max="100" value="85" aria-label="Output quality percentage slider" />
                        </div>
                        <div id="qualityNotice" class="form-text text-muted small">Higher quality produces better images with larger file sizes.</div>
                    </div>

                    <!-- Target Resolution Summary Box -->
                    <div class="summary-box p-3 rounded-3 mb-4 border">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="small text-secondary">Target Resolution:</span>
                            <span id="summaryDimensions" class="fw-bold font-monospace">—</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="small text-secondary">Target Aspect Ratio:</span>
                            <span id="summaryAspectRatio" class="badge bg-secondary font-monospace">—</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-secondary">Target Format:</span>
                            <span id="summaryFormat" class="fw-bold text-uppercase font-monospace text-primary">—</span>
                        </div>
                    </div>

                    <!-- Ready / Validation Summary Status Banner -->
                    <div id="readyBanner" class="alert alert-info d-none mb-3" role="status">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <strong id="readyTitle">Ready to resize.</strong>
                        </div>
                        <div id="readyDetails" class="small text-secondary"></div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <button type="button" id="resizeBtn" class="btn btn-primary btn-lg flex-grow-1 fw-bold py-2.5 rounded-3 btn-hover-elevate" disabled>
                            Resize Image
                        </button>
                        <button type="button" id="resetBtn" class="btn btn-outline-secondary btn-lg fw-semibold px-4 rounded-3">
                            Reset
                        </button>
                    </div>
                </div>
            </div>

            <!-- Compression Configuration Controls Card -->
            <div class="card card-custom shadow-xs d-none" id="compressControlsCard">
                <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="card-title mb-0 fw-semibold fs-6">Compression Settings</h5>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2.5 py-1">
                        Dimensions Invariant
                    </span>
                </div>
                <div class="card-body p-4">
                    <!-- Original Image Summary for Compression -->
                    <div class="summary-box p-3 rounded-3 mb-4 border">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="small text-secondary">Original Dimensions:</span>
                            <span id="compressOrigDimensions" class="fw-bold font-monospace">—</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="small text-secondary">Original Format:</span>
                            <span id="compressOrigFormat" class="badge bg-secondary font-monospace">—</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-secondary">Original Size:</span>
                            <span id="compressOrigSize" class="fw-bold font-monospace">—</span>
                        </div>
                    </div>

                    <!-- Panel 1: JPEG / WebP Quality Controls -->
                    <div id="compressQualitySection" class="mb-4 d-none">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="compressQualitySlider" class="form-label small fw-semibold text-secondary mb-0">Quality</label>
                            <span id="compressQualityBadge" class="badge bg-success font-monospace">75%</span>
                        </div>
                        <div class="range-slider-wrapper mb-2">
                            <input type="range" id="compressQualitySlider" class="form-range custom-range range-success" min="1" max="100" value="75" aria-label="Compression quality slider" />
                        </div>
                        
                        <!-- Quick Presets -->
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary compress-preset-btn rounded-pill px-2.5" data-quality="85">High Quality (85)</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary compress-preset-btn rounded-pill px-2.5 active" data-quality="75">Balanced (75)</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary compress-preset-btn rounded-pill px-2.5" data-quality="60">Max Compression (60)</button>
                        </div>
                        <div class="form-text text-muted small">Lossy compression: lower quality reduces file size while strictly preserving original dimensions.</div>
                    </div>

                    <!-- Panel 2: PNG Compression Effort Controls -->
                    <div id="compressPngSection" class="mb-4 d-none">
                        <label class="form-label small fw-bold text-secondary text-uppercase tracking-wider mb-2">Compression Effort Level</label>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary compress-png-btn rounded-pill px-3" data-level="1">Fast 1</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary compress-png-btn rounded-pill px-3" data-level="6">Standard 6</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary compress-png-btn rounded-pill px-3 active" data-level="9">Maximum 9</button>
                        </div>
                        <div class="alert alert-info py-2.5 px-3 small mb-0 rounded-3">
                            <div class="fw-bold mb-1 d-flex align-items-center gap-1.5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                </svg>
                                100% Lossless Compression
                            </div>
                            Compression effort levels adjust Deflate row filtering and dictionary search. PNG compression strictly preserves 100% pixel fidelity and alpha transparency. If a PNG is already optimally compressed, the pristine original is retained.
                        </div>
                    </div>

                    <!-- Panel 3: GIF / BMP Unsupported Notice -->
                    <div id="compressUnsupportedSection" class="alert alert-warning d-none mb-4 rounded-3" role="alert">
                        <strong>Unsupported Format:</strong> Compression is not supported for this format without conversion.
                    </div>

                    <!-- Target Dimensions Notice -->
                    <div class="summary-box p-3 rounded-3 mb-4 border">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="small text-secondary">Resulting Dimensions:</span>
                            <span id="compressTargetDimensions" class="fw-bold font-monospace text-success">—</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-secondary">Resulting Format:</span>
                            <span id="compressTargetFormat" class="fw-bold text-uppercase font-monospace text-secondary">—</span>
                        </div>
                    </div>

                    <!-- Ready / Validation Summary Status Banner -->
                    <div id="compressReadyBanner" class="alert alert-info d-none mb-3" role="status">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <strong class="fw-bold">Ready to compress.</strong>
                        </div>
                        <div id="compressReadyDetails" class="small text-secondary">Original dimensions and format will be strictly preserved.</div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2">
                        <button type="button" id="compressBtn" class="btn btn-success btn-lg flex-grow-1 fw-bold py-2.5 rounded-3 btn-hover-elevate" disabled>
                            Compress Image
                        </button>
                        <button type="button" id="compressResetBtn" class="btn btn-outline-secondary btn-lg fw-semibold px-4 rounded-3">
                            Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Result Section (Before / After Comparison and Download) -->
    <div id="resultSection" class="card card-custom shadow-sm border mt-5 d-none">
        <div class="card-header py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success p-1.5 rounded-circle me-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                </span>
                <h5 class="card-title mb-0 fw-bold fs-5" id="resultCardTitle">Processing Complete</h5>
                <span id="staleBadge" class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill d-none">Settings Changed</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="downloadBtn" class="btn btn-success px-4 py-2 fw-bold rounded-3 btn-hover-elevate d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Download Processed Image
                </button>
                <button type="button" id="uploadAnotherBtn" class="btn btn-outline-secondary px-3 py-2 fw-semibold rounded-3">
                    Upload Another
                </button>
            </div>
        </div>
        <div class="card-body p-4">
            <!-- Stale Notice -->
            <div id="staleNotice" class="alert alert-warning d-none mb-3 rounded-3" role="status">
                Settings changed. Process again to update the result.
            </div>

            <!-- Size Comparison Banner -->
            <div id="sizeComparisonBanner" class="p-3.5 bg-light rounded-3 mb-4 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="text-secondary small fw-medium d-block">File Size Comparison</span>
                    <span id="sizeComparisonText" class="fw-bold font-monospace fs-6">—</span>
                </div>
                <div>
                    <span id="sizeDeltaBadge" class="badge bg-success fs-6 py-2 px-3 rounded-pill font-monospace">—</span>
                </div>
            </div>

            <!-- Before / After Grid -->
            <div class="row g-4">
                <!-- Original Image Column -->
                <div class="col-lg-6">
                    <div class="card card-custom border h-100 shadow-xs">
                        <div class="card-header py-2.5 px-3 d-flex justify-content-between align-items-center border-bottom">
                            <span class="fw-bold small text-uppercase text-secondary tracking-wider">Original</span>
                            <span id="resultOriginalDimensionsBadge" class="badge bg-secondary font-monospace">—</span>
                        </div>
                        <div class="card-body p-3 text-center d-flex align-items-center justify-content-center">
                            <div class="result-img-container checkerboard-bg rounded-3">
                                <img id="resultOriginalImage" src="" alt="Original uploaded image" class="img-fluid rounded result-preview-img" />
                            </div>
                        </div>
                        <div class="card-footer bg-light border-top small text-muted py-2.5 px-3">
                            <div class="row g-1">
                                <div class="col-6"><strong>Format:</strong> <span id="resultOriginalFormat" class="font-monospace text-body">—</span></div>
                                <div class="col-6"><strong>Aspect Ratio:</strong> <span id="resultOriginalRatio" class="font-monospace text-body">—</span></div>
                                <div class="col-12"><strong>File Size:</strong> <span id="resultOriginalSize" class="font-monospace text-body">—</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Resized / Compressed Image Column -->
                <div class="col-lg-6">
                    <div class="card card-custom border border-primary-subtle h-100 shadow-xs">
                        <div class="card-header bg-primary-subtle py-2.5 px-3 d-flex justify-content-between align-items-center border-bottom border-primary-subtle">
                            <span id="resultOutputColumnTitle" class="fw-bold small text-uppercase text-primary tracking-wider">Processed</span>
                            <span id="resultOutputDimensionsBadge" class="badge bg-primary font-monospace">—</span>
                        </div>
                        <div class="card-body p-3 text-center d-flex align-items-center justify-content-center">
                            <div class="result-img-container checkerboard-bg rounded-3">
                                <img id="resultProcessedImage" src="" alt="Processed image" class="img-fluid rounded result-preview-img" />
                            </div>
                        </div>
                        <div class="card-footer bg-light border-top small text-muted py-2.5 px-3">
                            <div class="row g-1">
                                <div class="col-6"><strong>Format:</strong> <span id="resultOutputFormat" class="font-monospace text-body">—</span></div>
                                <div class="col-6"><strong>Aspect Ratio:</strong> <span id="resultOutputRatio" class="font-monospace text-body">—</span></div>
                                <div class="col-12"><strong>File Size:</strong> <span id="resultOutputSize" class="font-monospace text-body">—</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

